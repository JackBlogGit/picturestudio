# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，禁止提交。
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# 返图链接对外地址的站点前缀（拼 https://SITE_URL/s/<token>）。缺省取 CORS_ORIGIN 第一项。
# 走 Nginx 反代时必须填：请求里的 Host 是代理地址，不是浏览器地址栏那个域。
SITE_URL=http://localhost:5173

# 数据库类型：better-sqlite3（推荐，无需安装）或 mysql
DB_TYPE=better-sqlite3
DB_DATABASE=./piks_photo.db

# MySQL 配置（仅在 DB_TYPE=mysql 时使用）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=piks
# DB_PASSWORD=
# DB_NAME=piks_photo

# 密钥：生产环境必须替换为 openssl rand -base64 48 的输出
JWT_SECRET=
# 访问令牌有效期，单位秒（M1 未实现刷新令牌，过期后重新登录）
JWT_ACCESS_TTL_SEC=900

# 存储根目录，必须在 web root 之外（PRD 9.2）
STORAGE_ROOT=/data/piks
UPLOAD_MAX_IMAGE_SIZE=52428800
UPLOAD_MAX_FILE_SIZE=2147483648

# Redis（未配置时 JWT 黑名单退化为进程内 Map，仅单实例可用）
REDIS_URL=
